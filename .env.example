# MediDesk Hospital Management — Environment Configuration Template
# For local development: copy this file to .env
# For Vercel deployment: configure these in Vercel Dashboard -> Project Settings -> Environment Variables

# Supabase Backend Integration (Optional)
# When set, MediDesk synchronizes with your Supabase PostgreSQL instance.
# When left unset or blank, MediDesk functions in self-contained client-side mode with Web Storage & PBKDF2 hashing.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key-here...

# SECURITY NOTICE:
# - Only client-safe public keys (VITE_*) should ever be included here.
# - NEVER commit private credentials, passwords, or Supabase service_role keys to Git.
